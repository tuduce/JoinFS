<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:JoinFS.UI.Views.Controls">
  <!-- Icons from the design's inline SVGs, redrawn as geometry. Each is an 18 x 18 grid unless a ViewWidth says otherwise.
       Use as <c:Icon Source="{StaticResource IconHome}" Width="18" Height="18" />. They take the surrounding text colour. -->

  <!-- Sidebar -->
  <c:IconData x:Key="IconHome" StrokeWidth="1.6" Stroke="M3 9L9 3L15 9M5 9H13V15H5ZM9 15V12" />
  <c:IconData x:Key="IconHubs" StrokeWidth="1.4" Stroke="M9 4L4 13M9 4L14 13M4 13H14"
              Fill="M7 4A2 2 0 1 0 11 4A2 2 0 1 0 7 4ZM2 13A2 2 0 1 0 6 13A2 2 0 1 0 2 13ZM12 13A2 2 0 1 0 16 13A2 2 0 1 0 12 13Z" />
  <c:IconData x:Key="IconSession" Stroke="M3.8 7.5A3.2 3.2 0 1 0 10.2 7.5A3.2 3.2 0 1 0 3.8 7.5ZM8.8 9A3.2 3.2 0 1 0 15.2 9A3.2 3.2 0 1 0 8.8 9Z" />
  <c:IconData x:Key="IconAircraft" Fill="M15 9L3 5.6V7.6L9 9L3 10.4V12.4Z" />
  <c:IconData x:Key="IconObjects"
              Stroke="M4 3H7A1 1 0 0 1 8 4V7A1 1 0 0 1 7 8H4A1 1 0 0 1 3 7V4A1 1 0 0 1 4 3ZM11 3H14A1 1 0 0 1 15 4V7A1 1 0 0 1 14 8H11A1 1 0 0 1 10 7V4A1 1 0 0 1 11 3ZM4 10H7A1 1 0 0 1 8 11V14A1 1 0 0 1 7 15H4A1 1 0 0 1 3 14V11A1 1 0 0 1 4 10ZM11 10H14A1 1 0 0 1 15 11V14A1 1 0 0 1 14 15H11A1 1 0 0 1 10 14V11A1 1 0 0 1 11 10Z" />
  <c:IconData x:Key="IconModels" Stroke="M4 6H13M14 12H5" Fill="M13 4L16.5 6L13 8ZM5 10L1.5 12L5 14Z" />
  <c:IconData x:Key="IconFlightPlan" StrokeWidth="1.4"
              Stroke="M9 2L9 16M4 5L14 5M4 5C4 8 4 8 2 9C4 10 4 10 4 13L14 13C14 10 14 10 16 9C14 8 14 8 14 5" />
  <c:IconData x:Key="IconRecorder" Stroke="M3 9A6 6 0 1 0 15 9A6 6 0 1 0 3 9Z" Fill="M6.4 9A2.6 2.6 0 1 0 11.6 9A2.6 2.6 0 1 0 6.4 9Z" />
  <c:IconData x:Key="IconChat" Stroke="M5 4H13A2 2 0 0 1 15 6V10A2 2 0 0 1 13 12H5A2 2 0 0 1 3 10V6A2 2 0 0 1 5 4Z" Fill="M6 12L6 15.2L9.2 12Z" />
  <c:IconData x:Key="IconMonitor" Stroke="M4 4H14A1 1 0 0 1 15 5V11A1 1 0 0 1 14 12H4A1 1 0 0 1 3 11V5A1 1 0 0 1 4 4ZM7 15H11M5.2 7H9.5M5.2 9.3H8" />
  <c:IconData x:Key="IconSettings" Stroke="M14 9A5 5 0 1 0 4 9A5 5 0 1 0 14 9ZM9 1.8V3.8M9 14.2V16.2M1.8 9H3.8M14.2 9H16.2"
              Fill="M7.2 9A1.8 1.8 0 1 0 10.8 9A1.8 1.8 0 1 0 7.2 9Z" />

  <!-- Connection strip -->
  <c:IconData x:Key="IconNetworkNode" StrokeWidth="1.3"
              Stroke="M7 2H11V5.2H7ZM9 5.2V8M3 8H15M3 8V10M9 8V10M15 8V10M1 10H5V13.2H1ZM7 10H11V13.2H7ZM13 10H17V13.2H13Z" />

  <!-- Window and general -->
  <c:IconData x:Key="IconChevron" StrokeWidth="1.8" Stroke="M4 6L9 12L14 6" />
  <c:IconData x:Key="IconMinimize" StrokeWidth="1.4" Stroke="M4 9H14" />
  <c:IconData x:Key="IconMaximize" StrokeWidth="1.4" Stroke="M4.5 4.5H13.5V13.5H4.5Z" />
  <c:IconData x:Key="IconClose" StrokeWidth="1.4" Stroke="M4.5 4.5L13.5 13.5M13.5 4.5L4.5 13.5" />
  <c:IconData x:Key="IconExpand" StrokeWidth="1.4" Stroke="M10.5 3H15V7.5M15 3L9.5 8.5M7.5 15H3V10.5M3 15L8.5 9.5" />

  <!-- Recorder -->
  <c:IconData x:Key="IconOpen" StrokeWidth="1.3" Stroke="M2 6H6L7.5 4H13V6M2 6H16L15 14H3Z" />
  <c:IconData x:Key="IconAdd" StrokeWidth="1.4" Stroke="M9 4V14M4 9H14" />
  <c:IconData x:Key="IconSave" StrokeWidth="1.3"
              Stroke="M4 3H14A1 1 0 0 1 15 4V14A1 1 0 0 1 14 15H4A1 1 0 0 1 3 14V4A1 1 0 0 1 4 3ZM5.5 10H12.5V14H5.5Z" Fill="M6 3H12V7H6Z" />
  <c:IconData x:Key="IconPlay" Fill="M4 2L16 9L4 16Z" />
  <c:IconData x:Key="IconStop" Fill="M3 3H15V15H3Z" />
  <c:IconData x:Key="IconOverdub" StrokeWidth="1.4" Stroke="M7.3 11.5A4.2 4.2 0 1 0 15.7 11.5A4.2 4.2 0 1 0 7.3 11.5Z"
              Fill="M2.8 7A4.2 4.2 0 1 0 11.2 7A4.2 4.2 0 1 0 2.8 7Z" />
  <c:IconData x:Key="IconLoop"
              Stroke="M4 7C4 4.5 6 3 9 3C12.5 3 14.5 5 14.5 7.5M14 11C14 13.5 12 15 9 15C5.5 15 3.5 13 3.5 10.5"
              Fill="M14.5 4.5L14.5 8L11.5 6.5ZM3.5 13.5L3.5 10L6.5 11.5Z" />
  <c:IconData x:Key="IconTrimStart" StrokeWidth="1.4" ViewWidth="22"
              Stroke="M1.2 4.5A1.8 1.8 0 1 0 4.8 4.5A1.8 1.8 0 1 0 1.2 4.5ZM1.2 13.5A1.8 1.8 0 1 0 4.8 13.5A1.8 1.8 0 1 0 1.2 13.5ZM4.6 5.6L15 9M4.6 12.4L15 9M19 2V16" />
  <c:IconData x:Key="IconTrimEnd" StrokeWidth="1.4" ViewWidth="22"
              Stroke="M3 2V16M17.2 4.5A1.8 1.8 0 1 0 20.8 4.5A1.8 1.8 0 1 0 17.2 4.5ZM17.2 13.5A1.8 1.8 0 1 0 20.8 13.5A1.8 1.8 0 1 0 17.2 13.5ZM17.4 5.6L7 9M17.4 12.4L7 9" />
</ResourceDictionary>
