<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:JoinFS.UI.Localization"
             xmlns:ovm="using:JoinFS.UI.ViewModels.Overlays"
             x:Class="JoinFS.UI.Views.Overlays.MessageView"
             x:DataType="ovm:MessageViewModel">
  <Border Classes="dialog">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap" />
      <StackPanel Classes="footer" Margin="0,4,0,0" Spacing="10">
        <Button Classes="primary" Command="{Binding CloseCommand}" Content="{l:T 'OK'}" Padding="18,8" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
