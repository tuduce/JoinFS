<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ovm="using:JoinFS.UI.ViewModels.Overlays"
             x:Class="JoinFS.UI.Views.Overlays.PasswordPromptView"
             x:DataType="ovm:PasswordPromptViewModel">
  <Border Classes="dialog">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap" />
      <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="Password">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <StackPanel Classes="footer" Margin="0,4,0,0" Spacing="10">
        <Button Command="{Binding CloseCommand}" Content="Cancel" Padding="16,8" />
        <Button Classes="primary" Command="{Binding ConfirmCommand}" Content="Join" Padding="18,8" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
