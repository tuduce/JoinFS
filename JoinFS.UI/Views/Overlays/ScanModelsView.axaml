<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:JoinFS.UI.Views.Controls"
             xmlns:ovm="using:JoinFS.UI.ViewModels.Overlays"
             x:Class="JoinFS.UI.Views.Overlays.ScanModelsView"
             x:DataType="ovm:ScanModelsViewModel">
  <c:ModalCard Width="560" Title="{Binding Title}" CloseCommand="{Binding CloseCommand}" ShowClose="{Binding IsDismissable}">
    <StackPanel Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Simulator:" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SimulatorName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border CornerRadius="6" Padding="10,4" Background="{DynamicResource DangerTintBrush}" IsVisible="{Binding !SimulatorConnected}">
          <TextBlock Text="{Binding SimulatorLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="{Binding FolderPrompt}" FontSize="13" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Classes="mono" FontSize="12.5" Text="{Binding RootFolder}" Watermark="C:\...\Microsoft Flight Simulator" />
          <Button Grid.Column="1" Command="{Binding BrowseCommand}" Content="Browse..." Padding="16,9" />
        </Grid>
      </StackPanel>

      <!-- Subfolders only exist for a simulator with one SimObjects folder; without them the add-ons have the whole width. -->
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left" Width="249" Margin="0,0,14,0" Classes="card" CornerRadius="8" BorderBrush="{DynamicResource BorderInputBrush}" IsVisible="{Binding ShowSubfolders}">
          <StackPanel>
            <Border Padding="12,8" Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="Subfolder" FontSize="12.5" FontWeight="SemiBold" />
            </Border>
            <Panel Height="110">
              <TextBlock Text="No subfolders found" FontSize="12" Foreground="{DynamicResource DisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding NoSubfolders}" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Subfolders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ovm:ScanChoiceViewModel">
                      <Border Padding="12,4" BorderBrush="{DynamicResource SurfaceHeaderBrush}" BorderThickness="0,0,0,1">
                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" FontSize="12.5" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </StackPanel>
        </Border>
        <Border Classes="card" CornerRadius="8" BorderBrush="{DynamicResource BorderInputBrush}">
          <StackPanel>
            <Border Padding="12,8" Background="{DynamicResource SurfaceHeaderBrush}" BorderBrush="{DynamicResource BorderInputBrush}" BorderThickness="0,0,0,1">
              <TextBlock Text="Add-on" FontSize="12.5" FontWeight="SemiBold" />
            </Border>
            <Panel Height="110">
              <TextBlock Text="No add-ons found" FontSize="12" Foreground="{DynamicResource DisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding NoAddOns}" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding AddOns}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ovm:ScanChoiceViewModel">
                      <Border Padding="12,4" BorderBrush="{DynamicResource SurfaceHeaderBrush}" BorderThickness="0,0,0,1">
                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" FontSize="12.5" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </StackPanel>
        </Border>
      </DockPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Other folders to scan (one to a line):" FontSize="13" FontWeight="SemiBold" />
        <TextBox Classes="mono" FontSize="12" Height="70" AcceptsReturn="True" TextWrapping="NoWrap" Text="{Binding OtherFoldersText}"
                 Watermark="No additional folders added" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <c:ModalCard.Footer>
      <StackPanel Classes="footer" Spacing="14">
        <Button Command="{Binding CloseCommand}" Content="Cancel" Padding="18,8" />
        <Button Classes="primary" Command="{Binding ScanCommand}" Content="Scan" />
      </StackPanel>
    </c:ModalCard.Footer>
  </c:ModalCard>
</UserControl>
