<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ovm="using:JoinFS.UI.ViewModels.Overlays"
             x:Class="JoinFS.UI.Views.Overlays.ConfirmView"
             x:DataType="ovm:ConfirmViewModel">
  <Border Classes="dialog">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap" />
      <StackPanel Classes="footer" Margin="0,4,0,0" Spacing="10">
        <Button Command="{Binding CloseCommand}" Content="Cancel" Padding="16,8" />
        <Button Command="{Binding NoCommand}" Content="{Binding NoText}" Padding="16,8" />
        <Button Classes="primary" Command="{Binding YesCommand}" Content="{Binding YesText}" Padding="18,8" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
