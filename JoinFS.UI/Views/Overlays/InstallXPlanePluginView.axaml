<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:JoinFS.UI.Views.Controls"
             xmlns:ovm="using:JoinFS.UI.ViewModels.Overlays"
             x:Class="JoinFS.UI.Views.Overlays.InstallXPlanePluginView"
             x:DataType="ovm:InstallXPlanePluginViewModel">
  <c:ModalCard Width="460" Title="{Binding Title}" CloseCommand="{Binding CloseCommand}" ShowClose="{Binding IsDismissable}">
    <StackPanel Spacing="10">
      <TextBlock Text="Install the JoinFS plugin into your X-Plane folder:" FontSize="13" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Classes="mono" FontSize="12.5" Text="{Binding Folder}" Watermark="C:\X-Plane 12" />
        <Button Grid.Column="1" Command="{Binding BrowseCommand}" Content="Browse..." Padding="16,9" />
      </Grid>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="{DynamicResource DangerTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
    </StackPanel>
    <c:ModalCard.Footer>
      <StackPanel Classes="footer">
        <Button Command="{Binding CloseCommand}" Content="Cancel" Padding="18,8" />
        <Button Classes="primary" Command="{Binding InstallCommand}" Content="Install" />
      </StackPanel>
    </c:ModalCard.Footer>
  </c:ModalCard>
</UserControl>
