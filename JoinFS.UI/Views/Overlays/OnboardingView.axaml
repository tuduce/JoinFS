<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:JoinFS.UI.Localization"
             xmlns:ovm="using:JoinFS.UI.ViewModels.Overlays"
             x:Class="JoinFS.UI.Views.Overlays.OnboardingView"
             x:DataType="ovm:OnboardingViewModel">
  <!-- First run. It fills the window (see FillsWindow), the collapsed 376 x 180 one, with the 16px margin of the collapsed view. -->
  <Border Background="{DynamicResource SurfaceBrush}" Padding="16">
    <StackPanel Spacing="6" MaxWidth="344" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
      <TextBox Classes="compact" Text="{Binding Nickname}" Watermark="{l:T 'Your nickname'}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding ContinueCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Classes="link strong" FontSize="11" Command="{Binding ToggleSimbriefInputCommand}" Content="{l:T 'Using SimBrief?'}" />
      <TextBox Classes="compact" IsVisible="{Binding ShowSimbriefInput}" Text="{Binding SimbriefUsername}" Watermark="{l:T 'SimBrief username'}" />
      <Button Classes="primary" Command="{Binding ContinueCommand}" Content="{l:T 'Continue'}" FontSize="12"
              CornerRadius="6" Padding="0,6" Margin="0,2,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
