<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:JoinFS.UI.Localization"
             xmlns:ovm="using:JoinFS.UI.ViewModels.Overlays"
             x:Class="JoinFS.UI.Views.Overlays.UpdateAvailableView"
             x:DataType="ovm:UpdateAvailableViewModel">
  <Border Classes="dialog">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap" />
      <StackPanel Classes="footer" Margin="0,4,0,0" Spacing="18">
        <Button Classes="link" Command="{Binding CloseCommand}" Content="{l:T 'Close'}" FontSize="12.5"
                Foreground="{DynamicResource AccentLinkStrongBrush}" />
        <Button Classes="link strong" Command="{Binding DownloadCommand}" Content="{Binding DownloadText}" FontSize="12.5"
                Foreground="{DynamicResource AccentLinkStrongBrush}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
