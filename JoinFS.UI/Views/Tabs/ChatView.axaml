<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:JoinFS.UI.Localization"
             xmlns:m="using:JoinFS.UI.Models"
             xmlns:tvm="using:JoinFS.UI.ViewModels.Tabs"
             x:Class="JoinFS.UI.Views.Tabs.ChatView"
             x:DataType="tvm:ChatViewModel">
  <UserControl.Styles>
    <!-- A line of JoinFS's own, the answer to a command: it is not a pilot's. -->
    <Style Selector="TextBlock.local">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- What you said yourself: a tinted bubble on the right, without your name. -->
    <Style Selector="Border.own">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MaxWidth" Value="520" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <TextBlock Text="{l:T 'Chat'}" Classes="h2" />

    <Border Grid.Row="1" Classes="card">
      <ScrollViewer x:Name="MessageScroll">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:ChatMessage">
              <StackPanel Spacing="10">
                <!-- Where the lines you had not seen start. -->
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" IsVisible="{Binding IsFirstUnread}">
                  <Border Classes="hrule" Background="{DynamicResource AccentLinkBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{l:T 'New messages'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLinkBrush}" />
                  <Border Grid.Column="2" Classes="hrule" Background="{DynamicResource AccentLinkBrush}" VerticalAlignment="Center" />
                </Grid>
                <Border Classes.own="{Binding IsOwn}">
                  <TextBlock FontSize="13.5" TextWrapping="Wrap" Classes.local="{Binding IsLocal}"><Run Text="{Binding Stamp, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Text, Mode=OneWay}" /></TextBlock>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Classes="large" Text="{Binding Draft}" Watermark="{Binding ComposerHint}" IsEnabled="{Binding IsConnected}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Classes="primary" Command="{Binding SendCommand}" Content="{l:T 'Send'}" Padding="20,10" CornerRadius="8" FontSize="13.5" />
    </Grid>
  </Grid>
</UserControl>
