<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:JoinFS.UI.Localization"
             xmlns:c="using:JoinFS.UI.Views.Controls"
             xmlns:tvm="using:JoinFS.UI.ViewModels.Tabs"
             xmlns:vm="using:JoinFS.UI.ViewModels"
             x:Class="JoinFS.UI.Views.Tabs.AircraftView"
             x:DataType="tvm:AircraftViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="{l:T 'Aircraft'}" Classes="h2" />
        <TextBlock Text="{Binding AircraftCount, StringFormat='({0})'}" Classes="count" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="card">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="tableHeader" Padding="26,8,10,8">
          <Grid ColumnDefinitions="110,110,90,80,80,60,*">
            <Button Grid.Column="0" Classes="th" Command="{Binding CallsignColumn.SortCommand}" Content="{Binding CallsignColumn.Header}" />
            <Button Grid.Column="1" Classes="th" Command="{Binding OwnerColumn.SortCommand}" Content="{Binding OwnerColumn.Header}" />
            <Button Grid.Column="2" Classes="th" Command="{Binding DistanceColumn.SortCommand}" Content="{Binding DistanceColumn.Header}" />
            <Button Grid.Column="3" Classes="th" Command="{Binding HeadingColumn.SortCommand}" Content="{Binding HeadingColumn.Header}" />
            <Button Grid.Column="4" Classes="th" Command="{Binding AltitudeColumn.SortCommand}" Content="{Binding AltitudeColumn.Header}" />
            <Button Grid.Column="5" Classes="th" Command="{Binding GroundSpeedColumn.SortCommand}" Content="{Binding GroundSpeedColumn.Header}" />
            <Button Grid.Column="6" Classes="th" Command="{Binding ModelColumn.SortCommand}" Content="{Binding ModelColumn.Header}" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="tvm:AircraftRowViewModel">
                <Border Classes="row">
                  <StackPanel>
                    <Button Classes="rowButton" Classes.selected="{Binding IsExpanded}" Classes.tracked="{Binding IsTracked}" Classes.ignored="{Binding IsIgnored}"
                            Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{Binding AutomationName}"
                            AutomationProperties.HelpText="{l:T 'Shows or hides the actions of this row'}">
                      <Grid ColumnDefinitions="16,110,110,90,80,80,60,*" Margin="10,8">
                        <c:Icon Classes="chevron" Classes.open="{Binding IsExpanded}" Source="{DynamicResource IconChevron}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Callsign}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Owner}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Distance}" Classes.far="{Binding IsFar}" Classes.failed="{Binding IsFailed}" />
                        <TextBlock Grid.Column="4" Text="{Binding Heading}" />
                        <TextBlock Grid.Column="5" Text="{Binding Altitude}" />
                        <TextBlock Grid.Column="6" Text="{Binding GroundSpeed}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="7" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>

                    <Border Classes="expanded" IsVisible="{Binding IsExpanded}">
                      <Grid ColumnDefinitions="300,1,Auto" ColumnSpacing="32" HorizontalAlignment="Left">
                        <StackPanel Grid.Column="0" Spacing="8">
                          <TextBlock Classes="caps" Text="{l:T 'INFO'}" />
                          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6"
                                TextElement.Foreground="{DynamicResource Text3Brush}">
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4"><TextBlock Text="{l:T 'Squawk'}" /><TextBlock Classes="strong" Text="{Binding Squawk}" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4"><TextBlock Text="{l:T 'Bearing'}" /><TextBlock Classes="strong" Text="{Binding Bearing}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4"><TextBlock Text="COM1" /><TextBlock Classes="strong" Text="{Binding Com1}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4"><TextBlock Text="COM2" /><TextBlock Classes="strong" Text="{Binding Com2}" /></StackPanel>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="4"><TextBlock Text="{l:T 'Simulator'}" /><TextBlock Grid.Column="1" Classes="strong" Text="{Binding Simulator}" TextWrapping="Wrap" /></Grid>
                            <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="4"><TextBlock Text="{l:T 'Original Model'}" /><TextBlock Grid.Column="1" Classes="strong" Text="{Binding OriginalModel}" TextWrapping="Wrap" /></Grid>
                          </Grid>
                          <Border BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="4">
                              <TextBlock TextWrapping="Wrap"><Run Text="{l:T 'Flight Plan: '}" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" /><Run Text="{Binding FlightPlan, Mode=OneWay}" /></TextBlock>
                              <TextBlock TextWrapping="Wrap"><Run Text="{l:T 'Remarks: '}" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" /><Run Text="{Binding Remarks, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                          </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Classes="vrule" />

                        <ItemsControl Grid.Column="2" ItemsSource="{Binding ActionGroups}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="28" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tvm:ActionGroup">
                              <StackPanel Spacing="10">
                                <TextBlock Classes="caps" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Links}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionLink">
                                      <Button Classes="link" Command="{Binding Command}" Content="{Binding Label}" ToolTip.Tip="{Binding Hint}" Margin="0,0,0,8" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24">
      <CheckBox IsChecked="{Binding IncludeHubAircraft}" Content="{l:T 'Include All Hub Aircraft'}" />
      <CheckBox IsChecked="{Binding IncludeSimulatorAircraft}" Content="{l:T 'Include All Simulator Aircraft'}" />
    </StackPanel>
  </Grid>
</UserControl>
