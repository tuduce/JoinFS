<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:JoinFS.UI.Views.Controls"
             xmlns:vm="using:JoinFS.UI.ViewModels"
             xmlns:tvm="using:JoinFS.UI.ViewModels.Tabs"
             x:Class="JoinFS.UI.Views.Tabs.SettingsView"
             x:DataType="tvm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="20">
      <TextBlock Text="Settings" Classes="h2" />

      <StackPanel Spacing="10">

        <!-- Simulator -->
        <Border Classes="card">
          <StackPanel>
            <Button Classes="accordion" Command="{Binding Simulator.ToggleCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Simulator.Title}" FontSize="14" FontWeight="SemiBold" />
                <c:Icon Grid.Column="1" Classes="chevron" Classes.open="{Binding Simulator.IsOpen}" Source="{DynamicResource IconChevron}" />
              </Grid>
            </Button>
            <Border IsVisible="{Binding Simulator.IsOpen}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="18,14,18,18">
              <Panel DataContext="{Binding Simulator}">
                <StackPanel x:DataType="tvm:SimulatorSettingsViewModel" Spacing="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Nickname" Classes="label" />
                    <TextBox Text="{Binding Profile.Nickname}" Watermark="Nickname shown to other pilots" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <CheckBox IsChecked="{Binding ConnectOnLaunch}" Content="Connect simulator on launch" />
                    <CheckBox IsChecked="{Binding ElevationCorrection}" Content="Elevation Correction" />
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding CircleLabel}" Classes="label" />
                    <Slider Minimum="2" Maximum="600" Value="{Binding CircleOfActivityNm}" />
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding FollowLabel}" Classes="label" />
                    <Slider Minimum="20" Maximum="1000" Value="{Binding FollowDistanceM}" />
                  </StackPanel>

                  <!-- X-Plane label -->
                  <Border Classes="card" CornerRadius="8" Padding="14" IsVisible="{Binding IsXPlaneBuild}">
                    <StackPanel Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="X-Plane label" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="badge" VerticalAlignment="Center"><TextBlock Text="X-PLANE ONLY" /></Border>
                      </StackPanel>
                      <TextBlock Text="Controls the floating label JoinFS draws above other aircraft in X-Plane." FontSize="12"
                                 Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap" />
                      <UniformGrid Columns="2">
                        <CheckBox IsChecked="{Binding ShowNickname}" Content="Show Nickname" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding ShowCallsign}" Content="Show Callsign" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding ShowDistance}" Content="Show Distance" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding ShowAltitude}" Content="Show Altitude" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding ShowSpeed}" Content="Show Speed" />
                      </UniformGrid>
                      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <TextBlock Text="Label text colour" Classes="label" VerticalAlignment="Center" />
                        <Border Width="20" Height="20" CornerRadius="5" BorderThickness="1" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource BorderButtonBrush}" Background="{Binding LabelColor}" />
                        <Button Command="{Binding ToggleLabelColorPickerCommand}" Content="Choose..." FontSize="12.5" Padding="14,8" />
                      </StackPanel>
                      <StackPanel IsVisible="{Binding IsLabelColorPickerOpen}" Spacing="8">
                        <ItemsControl ItemsSource="{Binding LabelColorPresets}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Button Width="24" Height="24" Padding="0" Margin="0,0,6,6" CornerRadius="6"
                                      Background="{Binding}" BorderBrush="{DynamicResource BorderButtonBrush}"
                                      Command="{Binding $parent[ItemsControl].((tvm:SimulatorSettingsViewModel)DataContext).ChooseLabelColorCommand}"
                                      CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Classes="mono compact" Text="{Binding LabelColor}" Watermark="#RRGGBB" Width="110" HorizontalAlignment="Left" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="{Binding AutoImportSimbrief}" Content="Auto import SimBrief flight plan" VerticalAlignment="Center" />
                    <TextBox Classes="compact" Width="200" Text="{Binding Profile.SimbriefUsername}" Watermark="Simbrief UserName" />
                  </StackPanel>

                  <Border Classes="hrule" />

                  <StackPanel Spacing="6">
                    <TextBlock Text="Scan for models" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="Builds the list of aircraft models JoinFS can substitute during a flight." Classes="label" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <CheckBox IsChecked="{Binding Profile.ModelScanOnConnect}" Content="Model scan on connect" Margin="0,0,0,6" />
                    <CheckBox IsChecked="{Binding Profile.BroadcastTacpack}" Content="Auto broadcast VRS TacPack" Margin="0,0,0,6" />
                    <Button Classes="link strong" Command="{Binding OpenModelScanningCommand}" Content="Open Model Scanning..." />
                  </StackPanel>

                  <Border Classes="hrule" />

                  <StackPanel Spacing="6">
                    <TextBlock Text="Model matching" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="Substitute models used when an exact match isn't installed." Classes="label" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Button Classes="link strong" Command="{Binding OpenModelMatchingCommand}" Content="Open Model Matching →" />
                  </StackPanel>
                </StackPanel>
              </Panel>
            </Border>
          </StackPanel>
        </Border>

        <!-- User Interface -->
        <Border Classes="card">
          <StackPanel>
            <Button Classes="accordion" Command="{Binding UserInterface.ToggleCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding UserInterface.Title}" FontSize="14" FontWeight="SemiBold" />
                <c:Icon Grid.Column="1" Classes="chevron" Classes.open="{Binding UserInterface.IsOpen}" Source="{DynamicResource IconChevron}" />
              </Grid>
            </Button>
            <Border IsVisible="{Binding UserInterface.IsOpen}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="18,14,18,18">
              <Panel DataContext="{Binding UserInterface}">
                <StackPanel x:DataType="tvm:UserInterfaceSettingsViewModel" Orientation="Horizontal" Spacing="20">
                  <CheckBox IsChecked="{Binding AlwaysOnTop}" Content="Always on top" />
                  <CheckBox IsChecked="{Binding AutoRefresh}" Content="Auto refresh" />
                  <CheckBox IsChecked="{Binding ToolTips}" Content="Tool Tips" />
                </StackPanel>
              </Panel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Network -->
        <Border Classes="card">
          <StackPanel>
            <Button Classes="accordion" Command="{Binding Network.ToggleCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Network.Title}" FontSize="14" FontWeight="SemiBold" />
                <c:Icon Grid.Column="1" Classes="chevron" Classes.open="{Binding Network.IsOpen}" Source="{DynamicResource IconChevron}" />
              </Grid>
            </Button>
            <Border IsVisible="{Binding Network.IsOpen}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="18,14,18,18">
              <Panel DataContext="{Binding Network}">
                <StackPanel x:DataType="tvm:NetworkSettingsViewModel" Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="{Binding ChooseOwnPort}" Content="Choose my own port" VerticalAlignment="Center" />
                    <TextBox Classes="compact mono" Width="90" Text="{Binding LocalPort}" IsEnabled="{Binding PortEnabled}" />
                  </StackPanel>
                  <CheckBox IsChecked="{Binding JoinGlobalAtLaunch}" Content="Join global session at launch" />
                  <CheckBox IsChecked="{Binding LowBandwidth}" Content="Low bandwidth" />
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox IsChecked="{Binding GenerateWhazzup}" Content="Generate WhazzUp" />
                    <CheckBox Classes="small" IsChecked="{Binding WhazzupIncludeGlobalUsers}" IsEnabled="{Binding WhazzupOptionsEnabled}" Content="include global users" />
                    <CheckBox Classes="small" IsChecked="{Binding WhazzupIncludeAi}" IsEnabled="{Binding WhazzupOptionsEnabled}" Content="include AI" />
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Password" Classes="label" />
                    <TextBox Text="{Binding Password}" PasswordChar="•" />
                  </StackPanel>
                </StackPanel>
              </Panel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Hub Mode -->
        <Border Classes="card">
          <StackPanel>
            <Button Classes="accordion" Command="{Binding HubMode.ToggleCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding HubMode.Title}" FontSize="14" FontWeight="SemiBold" />
                <c:Icon Grid.Column="1" Classes="chevron" Classes.open="{Binding HubMode.IsOpen}" Source="{DynamicResource IconChevron}" />
              </Grid>
            </Button>
            <Border IsVisible="{Binding HubMode.IsOpen}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="18,14,18,18">
              <Panel DataContext="{Binding HubMode}">
                <StackPanel x:DataType="tvm:HubModeSettingsViewModel" Spacing="12">
                  <CheckBox IsChecked="{Binding Enabled}" Content="Enable Hub Mode" />
                  <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="tvm:HubFieldViewModel">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Label}" Classes="label" />
                          <TextBox Text="{Binding Value}" Watermark="{Binding Placeholder}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Panel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Address Book -->
        <Border Classes="card">
          <StackPanel>
            <Button Classes="accordion" Command="{Binding AddressBook.ToggleCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding AddressBook.Title}" FontSize="14" FontWeight="SemiBold" />
                <c:Icon Grid.Column="1" Classes="chevron" Classes.open="{Binding AddressBook.IsOpen}" Source="{DynamicResource IconChevron}" />
              </Grid>
            </Button>
            <Border IsVisible="{Binding AddressBook.IsOpen}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="18,14,18,18">
              <Panel DataContext="{Binding AddressBook.Book}">
                <StackPanel x:DataType="vm:AddressBookViewModel" Spacing="10">
                  <TextBlock Text="Hubs available from the picker, including the built-in Global directory." Classes="label" TextWrapping="Wrap" />
                  <Border Classes="card" CornerRadius="8">
                    <StackPanel>
                      <Border Classes="tableHeader" Padding="12,8">
                        <Grid ColumnDefinitions="*,*,64" ColumnSpacing="12" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource MutedBrush}">
                          <TextBlock Grid.Column="0" Text="Name" />
                          <TextBlock Grid.Column="1" Text="Address" />
                        </Grid>
                      </Border>
                      <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AddressBookRow">
                            <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                              <Grid ColumnDefinitions="*,*,64" ColumnSpacing="12" TextElement.FontSize="12.5">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                  <Border Classes="badge" IsVisible="{Binding IsBuiltIn}" VerticalAlignment="Center"><TextBlock Text="BUILT-IN" /></Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Address}" Classes="mono" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Classes="link danger" IsVisible="{Binding CanRemove}" Command="{Binding RemoveCommand}" Content="Remove" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Grid ColumnDefinitions="*,*,64" ColumnSpacing="12" Margin="12,0">
                    <TextBox Grid.Column="0" Classes="compact" FontSize="12.5" Padding="12,8" Text="{Binding NewName}" Watermark="Name" />
                    <TextBox Grid.Column="1" Classes="compact mono" FontSize="12.5" Padding="12,8" Text="{Binding NewAddress}" Watermark="Address:Port" />
                    <Button Grid.Column="2" Classes="primary" Command="{Binding AddCommand}" Content="Add" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Panel>
            </Border>
          </StackPanel>
        </Border>

        <!-- X-Plane: only in the XPLANE build -->
        <Border Classes="card" IsVisible="{Binding IsXPlaneBuild}">
          <StackPanel>
            <Button Classes="accordion" Command="{Binding XPlane.ToggleCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding XPlane.Title}" FontSize="14" FontWeight="SemiBold" />
                <c:Icon Grid.Column="1" Classes="chevron" Classes.open="{Binding XPlane.IsOpen}" Source="{DynamicResource IconChevron}" />
              </Grid>
            </Button>
            <Border IsVisible="{Binding XPlane.IsOpen}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="18,14,18,18">
              <Panel DataContext="{Binding XPlane}">
                <StackPanel x:DataType="tvm:XPlaneSettingsViewModel" Spacing="14">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Command="{Binding InstallPluginCommand}" Content="Install Plugin..." Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding InstallCppCommand}" Content="Install C++..." Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="6">
                      <TextBlock Text="IP Address" Classes="label" />
                      <TextBox Classes="mono" Text="{Binding IpAddress}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Tcas}" Content="TCAS" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                  </Grid>
                </StackPanel>
              </Panel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Variables -->
        <Border Classes="card">
          <StackPanel>
            <Button Classes="accordion" Command="{Binding Variables.ToggleCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Variables.Title}" FontSize="14" FontWeight="SemiBold" />
                <c:Icon Grid.Column="1" Classes="chevron" Classes.open="{Binding Variables.IsOpen}" Source="{DynamicResource IconChevron}" />
              </Grid>
            </Button>
            <Border IsVisible="{Binding Variables.IsOpen}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="18,0,18,18">
              <Panel DataContext="{Binding Variables}">
                <StackPanel x:DataType="tvm:VariablesSettingsViewModel">
                  <TextBlock Text="Models with non-default variable files assigned." Classes="label" Margin="0,14,0,10" />
                  <ItemsControl ItemsSource="{Binding Assignments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="tvm:VariableAssignmentViewModel">
                        <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding FilesText}" Classes="mono" FontSize="12" Foreground="{DynamicResource Muted2Brush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="link strong" Margin="14,0,0,0" VerticalAlignment="Center" Command="{Binding EditCommand}" Content="Edit…" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Panel>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
