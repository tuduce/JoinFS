<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:JoinFS.UI.Localization"
             xmlns:tvm="using:JoinFS.UI.ViewModels.Tabs"
             x:Class="JoinFS.UI.Views.Tabs.MonitorView"
             x:DataType="tvm:MonitorViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{l:T 'Monitor'}" Classes="h2" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="{Binding FpsText}" Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center" />
        <Button Command="{Binding ViewLogsCommand}" Content="{l:T 'View Logs...'}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <!-- Switches: they stay on until they are turned off. -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ToggleButton Classes="chip" IsChecked="{Binding LogNetwork}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="dot" VerticalAlignment="Center" />
            <TextBlock Text="{l:T 'Log network traffic'}" />
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="chip" IsChecked="{Binding LogVariables}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="dot" VerticalAlignment="Center" />
            <TextBlock Text="{l:T 'Log variables'}" />
          </StackPanel>
        </ToggleButton>
      </StackPanel>
      <!-- Actions: each writes a dump into the log once. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="caps" Text="{l:T 'WRITE TO THE LOG'}" VerticalAlignment="Center" />
        <Button Command="{Binding WriteNodeStatisticsCommand}" Content="{l:T 'Node Statistics'}" />
        <Button Command="{Binding WritePacketStatisticsCommand}" Content="{l:T 'Received Packets'}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource ConsoleBackgroundBrush}" CornerRadius="10" Padding="14">
      <ScrollViewer x:Name="LogScroll">
        <ItemsControl ItemsSource="{Binding LogLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="mono" FontSize="12" LineHeight="19.2"
                         Foreground="{DynamicResource ConsoleTextBrush}" TextWrapping="NoWrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding Status}" Classes="label" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>
