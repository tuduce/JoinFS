<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:JoinFS.UI.Localization"
             xmlns:c="using:JoinFS.UI.Views.Controls"
             xmlns:vm="using:JoinFS.UI.ViewModels"
             x:Class="JoinFS.UI.Views.UndockedTabView"
             x:DataType="vm:UndockedTabViewModel">
  <!-- In the main window, in place of a tab that is open in a window of its own. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
    <c:Icon Source="{DynamicResource IconUndock}" Width="36" Height="36" HorizontalAlignment="Center"
            Foreground="{DynamicResource Muted2Brush}" />
    <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
               Foreground="{DynamicResource MutedBrush}" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
      <Button Classes="primary" Command="{Binding ShowCommand}" Content="{l:T 'Show window'}" />
      <Button Command="{Binding DockCommand}" Content="{l:T 'Put back in the main window'}" />
    </StackPanel>
  </StackPanel>
</UserControl>
