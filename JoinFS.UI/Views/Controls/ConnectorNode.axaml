<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:JoinFS.UI.Views.Controls"
             xmlns:vm="using:JoinFS.UI.ViewModels"
             x:Class="JoinFS.UI.Views.Controls.ConnectorNode"
             x:DataType="vm:ConnectionViewModel"
             Width="56" ClipToBounds="False">
  <!-- One stop in the strip: a round button coloured by state, its name, and its state. DataContext is a ConnectionViewModel. -->
  <StackPanel>
    <Button x:Name="NodeButton" Classes="connector"
            Classes.connecting="{Binding IsConnecting}"
            Classes.connected="{Binding IsConnected}"
            Command="{Binding ToggleCommand}"
            ToolTip.Tip="{Binding ShortcutHint}"
            HorizontalAlignment="Center">
      <c:Icon x:Name="NodeIcon" Width="18" Height="18" />
    </Button>
    <!-- Negative side margins give the labels room to run past the 56px column, centred, like the design. -->
    <StackPanel Margin="-30,6,-30,0" HorizontalAlignment="Center">
      <TextBlock x:Name="TitleText" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextAlignment="Center" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding StateLabel}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
