{
  "_comment": "Scenarios for a remote aircraft reporting a collapsed designator (GLID). Run by the JoinFS matcher (FoldedScenarioTests.cs) and by the proximity map (test/matcher.test.mjs): both must pick the same installed model. Keep the copies in both repos identical.",
  "scenarios": [
    { "name": "the model naming the same aircraft wins whatever its tag", "remote": { "tag": "GLID", "title": "LS4 Red" },
      "installed": [ {"title": "GLID blue", "variation": "blue", "tag": "GLID"}, {"title": "JS3-15 white", "variation": "white", "tag": "JS3-15"}, {"title": "DG LS8", "variation": "", "tag": "LS8"}, {"title": "LS4 Blue", "variation": "Blue", "tag": "LS4"} ],
      "expect": "LS4 Blue" },
    { "name": "the same hint beats a model that merely carries the tag", "remote": { "tag": "GLID", "title": "LS4" },
      "installed": [ {"title": "GLID blue", "variation": "blue", "tag": "GLID"}, {"title": "LS4 Blue", "variation": "Blue", "tag": "LS4"} ],
      "expect": "LS4 Blue" },
    { "name": "without a match the generic glider is a last resort, a close identified model wins", "remote": { "tag": "GLID", "title": "LS4 Red" },
      "installed": [ {"title": "GLID blue", "variation": "blue", "tag": "GLID"}, {"title": "JS3-15 white", "variation": "white", "tag": "JS3-15"}, {"title": "DG LS8", "variation": "", "tag": "LS8"} ],
      "expectNot": "GLID blue" },
    { "name": "the generic glider is used when it is all that is installed", "remote": { "tag": "GLID", "title": "LS4 Red" },
      "installed": [ {"title": "GLID blue", "variation": "blue", "tag": "GLID"} ],
      "expect": "GLID blue" },
    { "name": "a remote that names nothing gets the generic glider", "remote": { "tag": "GLID", "title": "Mystery 77" },
      "installed": [ {"title": "GLID blue", "variation": "blue", "tag": "GLID"}, {"title": "JS3-15 white", "variation": "white", "tag": "JS3-15"} ],
      "expect": "GLID blue" },
    { "name": "a JS3-18 remote gets the 18 m model", "remote": { "tag": "GLID", "title": "JS3-18 Rapture" },
      "installed": [ {"title": "JS3-15 white", "variation": "white", "tag": "JS3-15"}, {"title": "JS3-18 Waldo", "variation": "Waldo", "tag": "JS3-18"} ],
      "expect": "JS3-18 Waldo" },
    { "name": "a JS3-15 remote gets the 15 m model", "remote": { "tag": "GLID", "title": "JS3-15 Rapture" },
      "installed": [ {"title": "JS3-15 white", "variation": "white", "tag": "JS3-15"}, {"title": "JS3-18 Waldo", "variation": "Waldo", "tag": "JS3-18"} ],
      "expect": "JS3-15 white" },
    { "name": "club class: the title word wins over other members of the class", "remote": { "tag": "GLID", "title": "Schempp-Hirth Standard Cirrus" },
      "installed": [ {"title": "Schempp-Hirth Libelle H301", "variation": "Yellow", "tag": "GLID"}, {"title": "Standard Cirrus", "variation": "Red", "tag": "GLID"}, {"title": "GLID blue", "variation": "blue", "tag": "GLID"}, {"title": "DG LS8", "variation": "", "tag": "LS8"} ],
      "expect": "Standard Cirrus" },
    { "name": "club class: another spelling with the same word still wins", "remote": { "tag": "GLID", "title": "Standard Cirrus" },
      "installed": [ {"title": "Schempp-Hirth Libelle H301", "variation": "Yellow", "tag": "GLID"}, {"title": "Std Cirrus Green", "variation": "Green", "tag": "GLID"}, {"title": "GLID blue", "variation": "blue", "tag": "GLID"}, {"title": "DG LS8", "variation": "", "tag": "LS8"} ],
      "expect": "Std Cirrus Green" },
    { "name": "club class: the best fitting livery wins among several", "remote": { "tag": "GLID", "title": "Standard Cirrus Blue" },
      "installed": [ {"title": "Schempp-Hirth Libelle H301", "variation": "Yellow", "tag": "GLID"}, {"title": "Standard Cirrus", "variation": "Red", "tag": "GLID"}, {"title": "Standard Cirrus", "variation": "Blue", "tag": "GLID"} ],
      "expect": "Standard Cirrus", "expectVariation": "Blue" },
    { "name": "club class: without the word the class member closest to the row parameters wins", "remote": { "tag": "GLID", "title": "Standard Cirrus" },
      "installed": [ {"title": "Schempp-Hirth Libelle H301", "variation": "Yellow", "tag": "GLID"}, {"title": "DG LS8", "variation": "", "tag": "LS8"}, {"title": "GLID blue", "variation": "blue", "tag": "GLID"} ],
      "expect": "Schempp-Hirth Libelle H301" },
    { "name": "without the word and without a member the closest other aircraft is used", "remote": { "tag": "GLID", "title": "Standard Cirrus" },
      "installed": [ {"title": "DG LS8", "variation": "", "tag": "LS8"}, {"title": "GLID blue", "variation": "blue", "tag": "GLID"} ],
      "expect": "DG LS8" },
    { "name": "a K7 tagged AS7 is matched for a K7 remote", "remote": { "tag": "GLID", "title": "K7 Cream/Green (imperial)" },
      "installed": [ {"title": "GLID blue", "variation": "blue", "tag": "GLID"}, {"title": "K7 Cream/Red (imperial)", "variation": "Cream/Red (knots)", "tag": "AS7"} ],
      "expect": "K7 Cream/Red (imperial)" },
    { "name": "a wooden remote gets the installed K7 rather than a modern glider", "remote": { "tag": "GLID", "title": "Grunau Baby" },
      "installed": [ {"title": "DG-1001-E Neo", "variation": "", "tag": ""}, {"title": "DG LS8", "variation": "", "tag": "LS8"}, {"title": "Schleicher K7 GlideSimmer+B21", "variation": "Two seat trainer", "tag": "AS7"}, {"title": "LS4", "variation": "", "tag": "LS4"} ],
      "expect": "Schleicher K7 GlideSimmer+B21" },
    { "name": "a DG-1001 remote gets the installed untagged DG-1001", "remote": { "tag": "GLID", "title": "DG-1001 Club" },
      "installed": [ {"title": "DG-1001-E Neo", "variation": "", "tag": ""}, {"title": "DG LS8", "variation": "", "tag": "LS8"}, {"title": "Schleicher K7 GlideSimmer+B21", "variation": "Two seat trainer", "tag": "AS7"}, {"title": "LS4", "variation": "", "tag": "LS4"} ],
      "expect": "DG-1001-E Neo" }
  ]
}
