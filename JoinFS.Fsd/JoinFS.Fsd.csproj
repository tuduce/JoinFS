<Project Sdk="Microsoft.NET.Sdk">

  <!-- FSD text as typed values (docs/ATC/atc-fsd-plan.md, stage 1): splitting and building lines, the
       packet verbs, the pitch/bank/heading packing, frequency and callsign rules, the relay policy.
       No sockets, no state, no reference to JoinFS and no build symbol, so every configuration reads
       and writes the same text. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>JoinFS.Fsd</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinFS" />
    <InternalsVisibleTo Include="JoinFS.Tests" />
  </ItemGroup>

</Project>
