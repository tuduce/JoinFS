<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RecordingXRay.ViewModels"
        xmlns:views="using:RecordingXRay.Views"
        x:Class="RecordingXRay.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="40,44,*,12,248,28">

    <!-- Title bar: logo, address pill, Open. The right gap is where the system caption buttons sit. -->
    <Grid x:Name="TitleBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto,140" Background="{StaticResource WindowBrush}">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
        <Panel Width="18" Height="18">
          <Border CornerRadius="5" Background="{StaticResource AccentBrush}" />
          <Path Data="{StaticResource IconLogoRing}" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="1.6" />
          <Path Data="{StaticResource IconLogoTicks}" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
        </Panel>
        <TextBlock Text="RecordingXRay" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" />
      </StackPanel>

      <Border Grid.Column="1" Width="520" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource PillBrush}" BorderBrush="{StaticResource RaisedBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12,0" ToolTip.Tip="{Binding FilePath}">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconFile}" Width="14" Height="14" Margin="0,0,8,0" />
          <!-- Folder in muted text, file name in primary text; a long path loses the start of the folder, not the name. -->
          <TextBlock Grid.Column="1" Classes="mono" FontSize="12" IsVisible="{Binding HasFile}"
                     TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center">
            <Run Text="{Binding FileDirectory}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding FileName}" />
          </TextBlock>
          <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="No recording open"
                     IsVisible="{Binding !HasFile}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Button Grid.Column="2" Classes="primary" Command="{Binding OpenCommand}" Margin="12,0,0,0"
              ToolTip.Tip="Open a recording (Ctrl+O)" AutomationProperties.Name="Open recording">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon" Data="{StaticResource IconFolderOpen}" Width="14" Height="14" StrokeThickness="1.5" />
          <TextBlock Text="Open" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Summary strip -->
    <Border Grid.Row="1" Background="{StaticResource StripBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1" Padding="20,0">
      <ItemsControl ItemsSource="{Binding SummaryItems}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="28" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SummaryItem">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="caption" Text="{Binding Label}" VerticalAlignment="Center" />
              <TextBlock Classes="value" Classes.dim="{Binding IsPlaceholder}" Text="{Binding Value}" VerticalAlignment="Center" />
              <TextBlock Classes="mono muted" FontSize="11.5" Text="{Binding Extra}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="12,12,12,0">

      <Border Grid.Row="0" IsVisible="{Binding HasError}" Margin="0,0,0,12" Padding="14,8"
              Background="{StaticResource ErrorTintBrush}" BorderBrush="{StaticResource ErrorBrush}"
              BorderThickness="1" CornerRadius="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Command="{Binding DismissErrorCommand}" Width="28" Height="28"
                  Margin="12,0,0,0" AutomationProperties.Name="Dismiss error" ToolTip.Tip="Dismiss">
            <Path Classes="icon" Data="{StaticResource IconClose}" />
          </Button>
        </Grid>
      </Border>

      <!-- Empty state: nothing loaded yet -->
      <Panel Grid.Row="1" IsVisible="{Binding IsEmpty}">
        <Border Classes="panel" BorderThickness="0" CornerRadius="12" />
        <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource StrongBorderBrush}" StrokeThickness="1"
                   StrokeDashArray="4,4" />
        <StackPanel Width="440" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Data="{StaticResource IconEmptyRecording}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4"
                StrokeLineCap="Round" StrokeJoin="Round" Width="72" Height="72" Stretch="None" HorizontalAlignment="Center" />
          <TextBlock Text="Open a joinfs recording" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Drop a .jfs file here to see every aircraft on a map, browse its frames on a timeline and inspect each recorded value."
                     TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Foreground="{StaticResource KeyLabelBrush}" />
          <Button Classes="primary large" Command="{Binding OpenCommand}" HorizontalAlignment="Center"
                  AutomationProperties.Name="Choose file">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{StaticResource IconFolderOpen}" StrokeThickness="1.5" />
              <TextBlock Text="Choose file" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <StackPanel Width="440" Spacing="6" Margin="0,16,0,0" IsVisible="{Binding HasRecent}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="RECENT" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Content="Clear" FontSize="11.5" Height="24" Padding="8,0" VerticalContentAlignment="Center"
                      Command="{Binding ClearRecentCommand}" AutomationProperties.Name="Clear the recent files list" />
            </Grid>
            <ItemsControl ItemsSource="{Binding RecentFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentFile">
                  <Button Classes="recent" Command="{Binding Open}" ToolTip.Tip="{Binding Path}" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                      <Path Classes="icon" Data="{StaticResource IconFile}" Width="14" Height="14" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding FileName}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="mono muted" FontSize="11.5" Margin="10,0,0,0" Text="{Binding Directory}"
                                 TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Panel>

      <!-- Shown while a file is dragged over the window -->
      <Border Grid.Row="1" IsVisible="{Binding IsDragOver}" IsHitTestVisible="False" CornerRadius="12" BorderThickness="2"
              BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource AccentTintBrush}">
        <TextBlock Text="Drop the file to open it" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,28,0,0" />
      </Border>

      <!-- Loaded: frame browser | map | inspector (filled in by the next milestones) -->
      <Grid Grid.Row="1" IsVisible="{Binding HasRecording}" ColumnDefinitions="400,12,*,12,440">
        <Grid.Styles>
          <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
          </Style>
        </Grid.Styles>

        <views:FrameBrowserView Grid.Column="0" />

        <GridSplitter Grid.Column="1" AutomationProperties.Name="Resize frame browser" />
        <Border Grid.Column="1" Width="3" Height="36" CornerRadius="2" Background="{StaticResource RaisedBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

        <views:MapView Grid.Column="2" DataContext="{Binding Map}" />
        <GridSplitter Grid.Column="3" AutomationProperties.Name="Resize inspector" />
        <Border Grid.Column="3" Width="3" Height="36" CornerRadius="2" Background="{StaticResource RaisedBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

        <views:InspectorView Grid.Column="4" DataContext="{Binding Inspector}" />
      </Grid>
    </Grid>

    <!-- Resize handle between the workspace and the timeline dock -->
    <GridSplitter Grid.Row="3" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="Resize timeline" />

    <!-- Timeline dock -->
    <views:TimelineView Grid.Row="4" Margin="12,0" />

    <!-- Status bar -->
    <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0">
      <Ellipse Grid.Column="0" Classes="dot" Classes.ok="{Binding IsStatusLoaded}" Classes.busy="{Binding IsStatusLoading}"
               Classes.err="{Binding IsStatusError}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="{Binding StatusText}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsStatusLoading}" Width="120" Height="3"
                   MinHeight="3" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Foreground="{StaticResource AccentBrush}" Background="{StaticResource RaisedBrush}" />
      <TextBlock Grid.Column="3" Classes="mono muted" FontSize="12" Text="{Binding FrameStatusText}" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
