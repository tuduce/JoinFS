<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line tool for .jfs2 files (docs/recording/jfs2): dump, verify and repair. Uses only the format
       library, so it knows nothing of positions or variables and needs no simulator. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>jfs2</AssemblyName>
    <RootNamespace>JoinFS.Recording.Tool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JoinFS.Recording.Format\JoinFS.Recording.Format.csproj" />
  </ItemGroup>

</Project>
